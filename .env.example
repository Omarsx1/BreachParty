# Supabase project (Project Settings > API)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: public origin used inside the join URL and QR code.
# Set it when the host runs on localhost but players join from phones on the LAN,
# e.g. http://192.168.1.20:4321 (the host must be reachable from the phones).
PUBLIC_PLAY_ORIGIN=
